{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Full Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "tests"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CG C++: Debug solution",
      "presentation": {
        "group": "cg"
      },
      "type": "cppdbg",
      "request": "launch",
      "program": "/build/cpp/debug/solution",
      "cwd": "/build",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": true,
      "targetArchitecture": "arm64",
      "externalConsole": false,
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "cg-toolchain-9e84e543be86",
          "sh",
          "-c"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "pipeCwd": ""
      },
      "setupCommands": [
        {
          "text": "set exec-wrapper stdbuf -o0 -e0",
          "description": "unbuffer the program's output",
          "ignoreFailures": true
        },
        {
          "text": "set args < /build/debug-stdin 2>&1",
          "description": "feed the test case to stdin; surface stderr in the Debug Console"
        },
        {
          "text": "set auto-load safe-path /",
          "description": "allow libstdc++ pretty-printers",
          "ignoreFailures": true
        },
        {
          "text": "-enable-pretty-printing",
          "description": "enable pretty printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CG C++: Prepare debug session"
    },
    {
      "name": "CG Python3: Debug solution",
      "presentation": {
        "group": "cg"
      },
      "type": "debugpy",
      "request": "launch",
      "module": "codingame_tools.debug",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
