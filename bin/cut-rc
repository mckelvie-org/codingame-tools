#!/usr/bin/env bash
# Cut a release candidate by tagging the current HEAD of main.
# Computes the next rc counter from existing tags (unique regardless of main's
# current dev release number -- no need to bump that first), sets pyproject.toml
# to X.Y.Z-rc.N in a worktree, and pushes the tag — triggering publish-test.yml.
# Uses a git worktree so the dev's working directory is never modified.
# Finally waits for that workflow to finish and reports its outcome.
#
# Usage: cut-rc [--force] [--no-changelog]
#   --force         overwrite an existing tag (allows retrying a failed publish)
#   --no-changelog  proceed even though CHANGELOG.md has no release notes for this release,
#                   asserting there are none. Records "No notable changes." rather than leaving
#                   the placeholder, and commits that to main.
#
# Refuses to cut an rc whose CHANGELOG.md unreleased entry is missing or still the placeholder:
# cut-prod promotes the rc snapshot verbatim and never consults main, so notes written after this
# point can never reach the release.
set -euo pipefail

if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh CLI not found in PATH — run bin/install-gh-cli, or open a new terminal if you just installed it" >&2
    exit 1
fi

FORCE=0
NO_CHANGELOG=0
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --force)         FORCE=1 ;;
        --no-changelog)  NO_CHANGELOG=1 ;;
        *) echo "error: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

# Everything the release is cut from must already be on origin/main: a tag pointing at a commit
# nobody else has is worse than no tag. Checked twice -- once now, and again after bin/cut-rc-prep
# has had its chance to change things (see below).
verify_clean_and_synced() {
    local when="$1"

    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "error: working tree has uncommitted changes $when — commit or stash first" >&2
        exit 1
    fi

    if [[ "$(git branch --show-current)" != "main" ]]; then
        echo "error: cut-rc must be run on main" >&2
        exit 1
    fi

    git fetch --force --tags origin main

    local local_sha remote_sha
    local_sha=$(git rev-parse HEAD)
    remote_sha=$(git rev-parse origin/main)
    if [[ "$local_sha" != "$remote_sha" ]]; then
        echo "error: local main ($local_sha) is not in sync with origin/main ($remote_sha) $when — pull/rebase (and push, if you have local commits) first" >&2
        exit 1
    fi
}

# Release notes must exist BEFORE the rc is cut, because cut-prod promotes the rc snapshot
# verbatim and never consults main -- notes written afterwards can never reach the release. Checked
# here, first, so a run that is going to be refused doesn't first push a docs commit and burn an rc
# number and a TestPyPI publish discovering it.
pdm run python - "$NO_CHANGELOG" <<'PY'
import re, sys

no_changelog = sys.argv[1] == "1"
PLACEHOLDER = "- _Add release notes here._"

with open("CHANGELOG.md") as f:
    text = f.read()

# The unreleased section's own body specifically, not a substring search over the file--prose
# elsewhere (including this project's own docs about the placeholder) may quote it verbatim.
m = re.search(r"^## \{\{UNRELEASED\}\}\n(.*?)(?=^## |\Z)", text, re.MULTILINE | re.DOTALL)
body = m.group(1).strip() if m else ""

if body and body != PLACEHOLDER:
    sys.exit(0)

if not no_changelog:
    what = "is still cut-rc's placeholder" if m else "does not exist"
    sys.exit(
        f"error: CHANGELOG.md's '## {{{{UNRELEASED}}}}' entry {what}.\n"
        "       Write the release notes now: cut-prod promotes this rc's snapshot verbatim and\n"
        "       never reads main, so notes added later cannot reach the release.\n"
        "       If there genuinely are none, re-run with --no-changelog."
    )

# --no-changelog: record that as a fact rather than shipping the placeholder as the permanent
# record. Written to the working tree so main and the rc agree; committed by the caller below.
NO_NOTES = "- No notable changes."
if m:
    # group(1) spans the blank lines around the body too, so put them back explicitly.
    text = text[:m.start(1)] + f"\n{NO_NOTES}\n\n" + text[m.end(1):]
else:
    text = re.sub(r"^(# CHANGELOG\n+)", rf"\g<1>## {{{{UNRELEASED}}}}\n\n{NO_NOTES}\n\n", text)
with open("CHANGELOG.md", "w") as f:
    f.write(text)
print("--no-changelog: recorded 'No notable changes.' in CHANGELOG.md", file=sys.stderr)
PY

# --no-changelog edits the working tree, so commit it before the clean-tree check below.
if [[ "$NO_CHANGELOG" -eq 1 ]] && ! git diff --quiet -- CHANGELOG.md; then
    git add CHANGELOG.md
    git commit -q -m "chore: record no notable changes for this release"
    git push -q origin main
    echo "Committed and pushed the 'no notable changes' CHANGELOG entry to main." >&2
fi

verify_clean_and_synced "before preparing the release"

# Project-specific preparation hook, run on main before anything is tagged.
#
# cut-rc itself is meant to be reusable across projects, so it holds no policy about what a given
# project needs doing first -- regenerating build artifacts that are committed, refreshing a
# generated table, whatever. A project that needs none simply doesn't have this file.
#
# The contract: cut-rc-prep may commit and push to main; when it returns, the tree must be clean and
# in sync with origin/main again. That's re-verified rather than trusted, because everything after
# this point tags whatever HEAD happens to be -- a hook that left work uncommitted would silently
# ship a release built from a tree nobody can reproduce.
if [[ -x "bin/cut-rc-prep" ]]; then
    echo "Running bin/cut-rc-prep..." >&2
    ./bin/cut-rc-prep
    verify_clean_and_synced "after bin/cut-rc-prep"
fi

eval "$(pdm run python - <<'PY'
import re, subprocess, sys

with open("pyproject.toml") as f:
    text = f.read()

vm = re.search(r'^version\s*=\s*"([^"]*)"', text, re.MULTILINE)
if not vm:
    sys.exit("version= line not found in pyproject.toml")
current = vm.group(1)

m = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)-dev\.(\d+)", current)
if not m:
    sys.exit(f"expected X.Y.Z-dev.N in pyproject.toml, got: {current!r}")

x, y, z = int(m.group(1)), int(m.group(2)), int(m.group(3))
xyz = f"{x}.{y}.{z}"

tags = subprocess.check_output(["git", "tag", "--list", f"v{xyz}-rc.*"]).decode().split()
ns = [int(re.search(r"rc\.(\d+)$", t).group(1)) for t in tags if re.search(r"rc\.(\d+)$", t)]
n = max(ns) + 1 if ns else 1
new = f"{xyz}-rc.{n}"

nm = re.search(r'^name\s*=\s*"([^"]*)"', text, re.MULTILINE)
if not nm:
    sys.exit("name= line not found in pyproject.toml")
package_name = nm.group(1)

remote = subprocess.check_output(["git", "remote", "get-url", "origin"]).decode().strip()
rm = re.search(r'github\.com[:/](.+?)(?:\.git)?$', remote)
if not rm:
    sys.exit(f"could not parse GitHub repo from remote: {remote!r}")
github_repo = rm.group(1)

print(f"version: {current} → {new}", file=sys.stderr)
print(f"RC_VERSION={new}")
print(f"PACKAGE_NAME={package_name}")
print(f"GITHUB_REPO={github_repo}")
PY
)"

if git rev-parse "v$RC_VERSION" >/dev/null 2>&1; then
    if [[ "$FORCE" -eq 0 ]]; then
        echo "error: tag v$RC_VERSION already exists — use --force to overwrite" >&2
        exit 1
    fi
    echo "warning: overwriting existing tag v$RC_VERSION" >&2
fi

TMP=$(mktemp -d)
trap 'git worktree remove --force "$TMP" 2>/dev/null; rm -rf "$TMP"' EXIT

git worktree add --detach "$TMP" HEAD

pdm run python - "$RC_VERSION" "$PACKAGE_NAME" "$GITHUB_REPO" "$TMP/pyproject.toml" "$TMP/README.md" <<'PY'
import re, sys
new, package_name, github_repo, toml_path, readme_path = sys.argv[1:6]

with open(toml_path) as f:
    text = f.read()
updated = re.sub(r'^(version\s*=\s*")[^"]*(")', rf'\g<1>{new}\2', text, flags=re.MULTILINE)
assert updated != text, "version= line not found in pyproject.toml"
source_url = f"https://github.com/{github_repo}/tree/v{new}"
updated = re.sub(r'^(Source\s*=\s*")[^"]*(")', rf'\g<1>{source_url}\2', updated, flags=re.MULTILINE)

# Pin the version-scoped project URLs to this release's tag, so PyPI's sidebar links for a given
# version point at that version's files.
#
# Two conditions, both required, so that project-scoped links are never stamped with a version:
#   1. the key is one PyPI treats as version-scoped (Documentation/Changelog; Source is handled
#      above). Homepage and Bug Tracker describe the project, not a release, and are left alone
#      even if they happen to point at a blob/tree URL.
#   2. the value actually looks like a GitHub blob/tree URL. A project pointing Documentation at
#      Read the Docs, or at a deliberately-unpinned /latest/ URL, matches nothing and is untouched.
for _key in ("Documentation", "Changelog"):
    updated = re.sub(
        rf'^("?{_key}"?\s*=\s*"https://github\.com/[^"]*?/(?:blob|tree)/)(?:main|v[0-9][^/"]*)(/[^"]*")',
        rf'\g<1>v{new}\g<2>', updated, flags=re.MULTILINE)

with open(toml_path, "w") as f:
    f.write(updated)

pypi_ver = re.sub(r"-rc\.", "rc", new)
pypi_url = f"https://test.pypi.org/project/{package_name}/{pypi_ver}/"
badge_url = f"https://img.shields.io/badge/pypi-v{pypi_ver}-blue.svg"
python_badge = "https://img.shields.io/badge/python-3.10%20|%203.11%20|%203.12%20|%203.13%20|%203.14-blue.svg"
ci_badge = "https://img.shields.io/badge/CI-passing-brightgreen.svg"
with open(readme_path) as f:
    readme = f.read()
readme = re.sub(r'\[!\[PyPI version\]\([^)]*\)\]\([^)]*\)',
                f'[![PyPI version]({badge_url})]({pypi_url})', readme)
readme = re.sub(r'\[!\[Python versions\]\([^)]*\)\]\([^)]*\)',
                f'[![Python versions]({python_badge})](https://pypi.org/project/{package_name}/)', readme)
readme = re.sub(r'\[!\[CI\]\([^)]*\)\]\([^)]*\)',
                f'[![CI]({ci_badge})](https://github.com/{github_repo}/actions/workflows/ci.yml)', readme)
with open(readme_path, "w") as f:
    f.write(readme)
PY

# Prepend an unreleased CHANGELOG entry if one doesn't already exist. The heading is a
# version-independent sentinel, not the rc/prod version -- cut-prod fills that in (along with
# the date) when it promotes this rc, so there's no version string here that could ever drift
# out of sync with pyproject.toml's.
pdm run python - "$TMP/CHANGELOG.md" <<'PY'
import re, sys
path = sys.argv[1]
with open(path) as f:
    text = f.read()
header = "## {{UNRELEASED}}"
if header not in text:
    entry = f"{header}\n\n- _Add release notes here._\n\n"
    text = re.sub(r"^(# CHANGELOG\n+)", rf"\1{entry}", text)
    with open(path, "w") as f:
        f.write(text)
# Non-blocking: an rc is disposable/iterative and only reaches TestPyPI, not the permanent
# record, so this is just an early heads-up -- cut-prod hard-blocks on the same thing later.
# Checks the unreleased section's own body specifically (is it *exactly* the placeholder?),
# not a substring search over the whole file -- otherwise this would false-positive on prose
# elsewhere (e.g. this very comment, or CHANGELOG.md text documenting the placeholder itself)
# that happens to quote the placeholder string without actually being an unfilled entry.
m = re.search(r"^## \{\{UNRELEASED\}\}\n(.*?)(?=^## |\Z)", text, re.MULTILINE | re.DOTALL)
if m and m.group(1).strip() == "- _Add release notes here._":
    print("warning: CHANGELOG.md's unreleased entry is still just cut-rc's placeholder -- "
          "write real release notes before cutting a production release.", file=sys.stderr)
PY

# Make README.md's relative links absolute, pinned to this release's tag. PyPI renders README.md as
# the project front page but resolves relative links against pypi.org, so `[docs](doc/index.md)`
# would 404 for anyone clicking it there. Rewriting here -- in the throwaway worktree, after the
# badge patching above and before the commit -- means main keeps ordinary relative links (which
# render on GitHub and are checked by the test suite) while the tagged commit the package is built
# from, and therefore the README PyPI displays, is fully qualified.
pdm run python "$TMP/scripts/rewrite_readme_links.py" \
    "$TMP/README.md" "$GITHUB_REPO" "v$RC_VERSION" "$TMP"

# Same pinning for pyproject.toml's [project.urls], which become the link sidebar on the PyPI page.
# Those URLs are already absolute, so the rewrite above leaves them alone -- but a released version
# whose "Documentation" link points at `dev` would send readers to docs for unreleased work.
pdm run python "$TMP/scripts/rewrite_readme_links.py" \
    --pin-docs "$TMP/pyproject.toml" "v$RC_VERSION"

git -C "$TMP" add pyproject.toml CHANGELOG.md README.md
git -C "$TMP" commit -m "chore: release $RC_VERSION"
RC_SHA=$(git -C "$TMP" rev-parse HEAD)

if [[ "$FORCE" -eq 1 ]]; then
    git -C "$TMP" tag -f "v$RC_VERSION"
    git push --force origin "v$RC_VERSION"
else
    git -C "$TMP" tag "v$RC_VERSION"
    git push origin "v$RC_VERSION"
fi

# Wait for the triggered Publish TestPyPI workflow and report its outcome. Unlike
# cut-prod there's nothing to sync locally afterward -- this workflow only ever
# updates the rc-latest tag, never main. Identify the run by its head commit SHA,
# not `gh run list --branch` -- that flag isn't reliable for tag-triggered runs
# (it filters on branch refs, not tag refs). Errors from `gh` are allowed to print
# (not silenced) so an auth/API problem is visible instead of just "not found".
# If no run has matched by SHA halfway through, fall back to the most recently
# created run for this workflow -- for a solo/small-team repo, the newest run of
# a workflow we just triggered is almost certainly the one we're waiting on.
echo "Waiting for the Publish TestPyPI workflow to start..." >&2
RUN_ID=""
for attempt in $(seq 1 30); do
    RUN_ID=$(gh run list --workflow=publish-test.yml --json databaseId,headSha --limit 20 \
        --jq "[.[] | select(.headSha == \"$RC_SHA\")] | .[0].databaseId // empty") || true
    if [[ -n "$RUN_ID" ]]; then
        echo "Found run $RUN_ID for commit $RC_SHA." >&2
        break
    fi
    if [[ "$attempt" -eq 15 ]]; then
        FALLBACK_ID=$(gh run list --workflow=publish-test.yml --json databaseId --limit 1 --jq '.[0].databaseId // empty') || true
        if [[ -n "$FALLBACK_ID" ]]; then
            echo "No run matched commit $RC_SHA after $attempt attempts — falling back to the most recently created run for this workflow: $FALLBACK_ID" >&2
            RUN_ID="$FALLBACK_ID"
            break
        fi
    fi
    sleep 2
done

if [[ -z "$RUN_ID" ]]; then
    echo "warning: could not find the triggered Publish TestPyPI workflow run — check GitHub Actions manually" >&2
    exit 0
fi

echo "Watching run $RUN_ID..." >&2
if gh run watch "$RUN_ID" --exit-status; then
    echo "Publish TestPyPI succeeded for v$RC_VERSION." >&2
else
    cat >&2 <<EOF

========================================================================
  RELEASE CANDIDATE FAILED TO PUBLISH
========================================================================
  The tag v$RC_VERSION was created and pushed, but the Publish TestPyPI
  workflow failed. Nothing was published.

  Consequence worth knowing: the workflow updates the 'rc-latest' tag
  only on success, so 'rc-latest' still points at the PREVIOUS release
  candidate. 'cut-prod' with no argument resolves through 'rc-latest',
  so it would silently try to promote that older rc -- which is almost
  certainly not what you want.

  To recover, either:
    - fix the failure, then cut a new rc (the usual path); or
    - name the rc explicitly:  bin/cut-prod v$RC_VERSION

  Run: $(gh run view "$RUN_ID" --json url --jq .url 2>/dev/null || echo "see GitHub Actions")
========================================================================

EOF
    exit 1
fi
