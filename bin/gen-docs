#!/usr/bin/env bash
# Usage: gen-docs [--serve]
#
# Build the documentation site into site/ (never committed; CI deploys it).
#
# Everything generated is generated *during* the build and lives only inside it: the API reference
# from the source (scripts/gen_api_pages.py) and the CLI command reference from the argparse tree
# (scripts/gen_cli_pages.py). Neither has a committed copy, so neither can drift from the code it
# describes -- there is nothing to regenerate by hand, and nothing to forget to regenerate.
#
# Runs with --strict, so an unresolved cross-reference fails here exactly as it does in CI, rather
# than being discovered after a deploy.
#
# With --serve, runs a live-reloading local server instead of a one-shot build; use it when writing
# docs. For a browser window whose lifetime is the server's, use bin/docs instead.
set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
cd "$SCRIPT_DIR/.."

SERVE=false
for arg in "$@"; do
    case "$arg" in
        --serve) SERVE=true ;;
        *) echo "gen-docs: unrecognized argument: $arg" >&2; exit 2 ;;
    esac
done

if [ "$SERVE" = true ]; then
    echo "==> Serving the documentation site (Ctrl-C to stop)" >&2
    exec pdm run docs-serve
fi

echo "==> Documentation site (site/)" >&2
pdm run docs-build >&2

echo "==> Done. Browse site/index.html, or re-run with --serve for a live server." >&2
