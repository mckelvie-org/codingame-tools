#!/usr/bin/env bash
#
# Project-specific preparation, run by bin/cut-rc on main before anything is tagged.
#
# cut-rc is meant to be reusable across projects and holds no policy of its own; this file is where
# *this* project's policy lives. Contract with cut-rc: we may commit and push to main, and when we
# return the tree must be clean and in sync with origin/main. cut-rc re-verifies both rather than
# trusting us.
#
# What this does: regenerate the CLI reference under doc/cli/reference/ and, if it changed, commit
# and push that as its own commit on main.
#
# Why here rather than in the release commit: the reference is a build artifact, not source (see
# CONTRIBUTING.md's "Generated files"). On main it's allowed to lag -- nothing in CI enforces
# otherwise, deliberately -- but README links people at
# `blob/main/doc/cli/reference/...` for in-development docs, and at the release tag for published
# ones. Refreshing main here bounds the drift to one release cycle and, because cut-rc builds its
# release worktree from HEAD *after* we return, the tagged commit inherits the same regenerated
# files. One regeneration, and main and the tag agree by construction rather than by coincidence.
#
# Its own commit, not folded into the release commit, so that `git log doc/cli/reference` reads as a
# history of interface changes rather than being buried inside version bumps.

set -euo pipefail

GENERATED_PATH="doc/cli/reference"

echo "Regenerating ${GENERATED_PATH}..." >&2
pdm run gen-cli-reference >&2

# Only commit when something actually changed. The generator is deterministic -- same source in,
# byte-identical files out, independent of machine or working directory -- so an empty diff is the
# normal case and an empty commit on every release candidate would be pure noise.
if git diff --quiet -- "$GENERATED_PATH" && git diff --cached --quiet -- "$GENERATED_PATH" \
        && [[ -z "$(git status --porcelain -- "$GENERATED_PATH")" ]]; then
    echo "  ${GENERATED_PATH} already up to date; nothing to commit." >&2
    exit 0
fi

echo "  ${GENERATED_PATH} changed; committing and pushing to main." >&2
git add -A -- "$GENERATED_PATH"
git commit -m "chore: regenerate CLI reference

Automated by bin/cut-rc-prep before cutting a release candidate. The CLI
reference is generated from the argparse tree by \`pdm run gen-cli-reference\`."

# Plain push, no retry loop: cut-rc is interactive and a human is right here. If origin/main moved
# under us, failing with git's own message is more useful than looping -- pull, rerun, done.
git push origin main
